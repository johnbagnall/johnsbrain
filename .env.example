# Required: a random 32+ char secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# The public URL the app is served from. Used by Better Auth for redirects.
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite file lives. In Docker this is mounted as a named volume.
DATABASE_URL=file:./data/app.db
